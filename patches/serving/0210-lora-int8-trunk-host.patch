+        if (is_file(dir)) continue;   /* a generator's adapter file declares no targets here */
+        std::string err, b;
+        const int s = read_input_basis(name, dir, &b, &err);
+        if (s < 0) {
+            RAD_ERR("lora: %s", err.c_str());
+            return s;
+        }
+        if (b.empty()) {
+            if (keyless.empty()) keyless = name;
+            continue;
+        }
+        if (!cfg_.lora.input_basis.empty() && cfg_.lora.input_basis != b) {
+            RAD_ERR("lora: adapter '%s' declares \"radiance_input_basis\": \"%s\" and adapter '%s' "
+                    "declares \"%s\"; the sites' GEMMs are fed one activation, so every adapter "
+                    "must declare the same basis", basis_of.c_str(), cfg_.lora.input_basis.c_str(),
+                    name.c_str(), b.c_str());
