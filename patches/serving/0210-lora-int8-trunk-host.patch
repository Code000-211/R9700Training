+/* adapter_config.json's radiance_input_basis (lora::InputBasis, docs/ADAPTER.md §4): "" when the
+ * adapter declares no key. A value radiance serves no kernel for is refused here, naming it. */
+int read_input_basis(const std::string& name, const std::string& dir, std::string* out,
+                     std::string* err) {
+    const std::string path = dir + "/adapter_config.json";
+    std::ifstream f(path);
+    if (!f) { *err = "cannot read " + path; return RAD_E_NOTFOUND; }
+    nlohmann::json j;
+    try { f >> j; } catch (const std::exception& e) { *err = path + ": " + e.what(); return RAD_E_INVAL; }
+    const auto it = j.find("radiance_input_basis");
+    if (it == j.end() || it->is_null()) return RAD_OK;
+    if (!it->is_string()) { *err = path + ": radiance_input_basis is not a string"; return RAD_E_INVAL; }
+    *out = it->get<std::string>();
+    std::string why;
+    if (lora::parse_input_basis(*out, nullptr, &why) < 0) {
+        *err = fmt("adapter '%s': %s", name.c_str(), why.c_str());
+        return RAD_E_UNSUPPORTED;
+    }
+    return RAD_OK;
+}
+
