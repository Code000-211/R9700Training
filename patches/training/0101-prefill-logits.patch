--- /dev/null
+++ b/core/train_prefill.cpp
@@ -0,0 +1,96 @@
+/* train_prefill.cpp -- the training fixture's prefill on the Engine: a driver that replaces the
+ * HTTP server, as the KL mode does (core/engine_kld.cpp), but keeps the logits of every prompt
+ * position instead of scoring them. Config::prefill_prompts names the prompts and
+ * Config::prefill_logits receives them; the requests are scoring requests, so the batch builder
+ * emits a row per prompt position and score_rows copies them out. This is what the tests' tiny
+ * bf16 fixture (tests/support/fixture.h) runs through the same steps a serving request takes. */
+#include "engine_priv.h"
+
+#include "device/device.h"
+#include "server/sink.h"
+
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace rad {
+
+int Engine::run_prefill() {
+    const std::vector<std::vector<int32_t>>& prompts = cfg_.prefill_prompts;
+    RAD_TRY(open_scored_rows("prefill"));
+    const int64_t nv = meta_.n_vocab;
+
+    /* A prompt the KV pool cannot hold even alone would wait at the head of the queue forever:
+     * admission takes only a chunk the pool can hold, and nothing frees enough. Refused up front,
+     * naming the pool, as the KL mode does for its documents. */
+    {
+        const KVManager& kv = ranks_[0]->kv;
+        int64_t pool = INT64_MAX;
+        for (int32_t g = 0; g < kv.n_groups(); ++g) {
+            const KVGroupPlan* p = kv.plan(g);
+            if (p && p->paged() && p->window_blocks == 0)
+                pool = std::min<int64_t>(pool, p->n_blocks * p->block_size);
+        }
+        for (size_t d = 0; d < prompts.size(); ++d) {
+            const int64_t len = (int64_t)prompts[d].size();
+            if (len == 0) {
+                RAD_ERR("prefill: prompt %zu is empty", d);
+                return RAD_E_INVAL;
+            }
+            if (kv.can_ever_fit(len)) continue;
+            RAD_ERR("prefill: prompt %zu is %lld tokens and the KV pool holds %lld, so it can never "
+                    "be prefilled; lower --max-ctx or raise the cache", d, (long long)len,
+                    (long long)pool);
+            return RAD_E_FULL;
+        }
+    }
+
+    std::vector<std::vector<float>> rows(prompts.size());
+    prefill_prompt_.assign(prompts.size() + 1, -1);
+    for (size_t d = 0; d < prompts.size(); ++d) {
+        rows[d].assign(prompts[d].size() * (size_t)nv, 0.0f);
+        prefill_prompt_[d + 1] = (int64_t)d;   /* request ids start at 1, as in the KL mode */
+    }
+    prefill_rows_ = &rows;
+
+    std::vector<std::unique_ptr<server::Sink>> sinks(prompts.size());
+    std::vector<std::unique_ptr<Request>> reqs(prompts.size());
+    for (size_t d = 0; d < prompts.size(); ++d) {
+        sinks[d] = std::make_unique<server::Sink>(64);
+        auto r = std::make_unique<Request>();
+        r->id                    = d + 1;
+        r->prompt                = prompts[d];
+        r->max_tokens            = 1;      /* sampled from the last prefill row, never fed back */
+        r->ignore_eos            = true;
+        r->sp.temp               = 0.0f;
+        r->score                 = true;
+        r->sp.use_control_vector = cvec_default_on();
+        r->sink                  = sinks[d].get();
+        sinks[d]->id             = r->id;
+        reqs[d]                  = std::move(r);
+    }
+
+    /* All prompts are submitted under one hold of the queue, so the batching depends only on the
+     * prompts and the flags: a rerun batches identically. Preemption cannot change a row (the same
+     * positions are recomputed into the same place), so the rows a prompt gets are the rows it
+     * would have got alone, whatever share of the step it had. */
+    const auto t0 = std::chrono::steady_clock::now();
+    int bad = 0;
+    const int s = run_docs(reqs, sinks, false, "prefill", 30,
+                           [](size_t, double) {}, &bad);
+    prefill_rows_ = nullptr;
+    prefill_prompt_.clear();
+    RAD_TRY(s);
+    if (bad) return RAD_E_STATE;
+    int64_t positions = 0;
+    for (const auto& p : prompts) positions += (int64_t)p.size();
+    RAD_INFO("prefill: %zu prompts, %lld positions in %.0f s, %lld preemption(s)", prompts.size(),
+             (long long)positions,
+             std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(),
+             (long long)sched_.metrics().preemptions);
+    cfg_.prefill_logits = std::move(rows);
+    return RAD_OK;
+}
+
+}  /* namespace rad */
