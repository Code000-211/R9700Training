+        RAD_ISSUE(c, m.op_tap, brows(m.b_x, batch->n_tok),
+                  bcol(m.b_dfsrc, (int64_t)t * m.g.n_embd, m.g.n_embd, batch->n_tok));
+    }
+}
 
