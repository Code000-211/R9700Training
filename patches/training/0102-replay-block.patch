diff --git a/core/engine.cpp b/core/engine.cpp
index 3170856..41c03a2 100644
--- a/core/engine.cpp
+++ b/core/engine.cpp
@@ -3674,4 +3674,56 @@ int Engine::run_server() {
     return rc;
 }
 
+int Engine::replay_block(int64_t block) {
+    if (ranks_.empty()) return RAD_E_STATE;
+    for (auto& rk : ranks_) {
+        const RadBatch* b = rk->ctx.batch();
+        if (!b) return RAD_E_STATE;
+        /* The step's recurrent state is what the forward left behind that this block would read
+         * again: gdn_chunk_scan reads h0 unconditionally, so its layer is zeroed for every
+         * sequence, from the slots the batch's own state_index names (the card's copy, read back
+         * because a replay is a host path). The paged KV needs nothing: the batch's used counts and
+         * slot map are the step's start, and the block's stores overwrite every slot it reads. */
+        std::vector<int32_t> sidx;
+        for (int32_t g = 0; g < b->n_kv_groups; ++g) {
+            const KVGroupPlan* p = rk->kv.plan(g);
+            if (!p || !p->stateful() || block < 0) continue;
+            /* state_ptr takes the group's own layer index, and a group holds one cache per bound
+             * layer rather than per model layer: `block` is the absolute layer, so map it the way
+             * the issue path maps a KV operand. Without the map a group whose layers are not the
+             * model's first n hands back a null pointer and its state is never zeroed -- the
+             * layer's second replay then starts from the state its own first replay wrote. */
+            const KVPoolBinding* bind = rk->ctx.kv_binding((rad_kvgroup)g);
+            if (!bind || block >= (int64_t)bind->layer_slot.size()) continue;
+            const int32_t local = bind->layer_slot[(size_t)block];
+            if (local < 0) continue;
+            const int64_t pitch = b->kv[g].state_index_pitch;
+            if (pitch <= 0) continue;
+            sidx.resize((size_t)(b->n_seq * pitch));
+            if (rad_memcpy_async(sidx.data(), b->kv[g].state_index,
+                                 (int64_t)sidx.size() * (int64_t)sizeof(int32_t),
+                                 rk->ctx.stream()) < 0)
+                return RAD_E_DEVICE;
+            if (rad_stream_sync(rk->ctx.stream()) < 0) return RAD_E_DEVICE;
+            for (int32_t s = 0; s < b->n_seq; ++s) {
+                for (int64_t j = 0; j < pitch; ++j) {
+                    const int32_t slot = sidx[(size_t)s * (size_t)pitch + (size_t)j];
+                    if (slot < 0) continue;
+                    void* q = rk->kv.state_ptr(g, local, slot);
+                    if (!q) continue;
+                    if (rad_memset_async(q, 0, p->layer_bytes_per_state(), rk->ctx.stream()) < 0)
+                        return RAD_E_DEVICE;
+                }
+            }
+        }
+        if (rad_stream_sync(rk->ctx.stream()) < 0) return RAD_E_DEVICE;
+        rk->ctx.set_replay_block(block);
+        const int rc = rk->ctx.run_step(b);
+        rk->ctx.set_replay_block(-1);
+        if (rc < 0) return rc;
+        if (rad_stream_sync(rk->ctx.stream()) < 0) return RAD_E_DEVICE;
+    }
+    return RAD_OK;
+}
+
 }  /* namespace rad */
