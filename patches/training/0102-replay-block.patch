+/* A second observer, for a caller that must read an op's operands after it ran: `issued` is called
+ * once the op has launched (on the host backend, once it has run), where the issue observer above
+ * sees them before. `block` is the same bracket the issue observer sees, so a reader can snapshot
+ * a block's output at its end. A layer replay installs one to hand each op's bytes to its caller
+ * before the next op reuses the buffer. An observer must not call rad_issue. */
+typedef struct RadReplayObserver {
+    void* user;
+    void (*issued)(void* user, RadCtx* c, const RadIssueOp* o);
+    void (*block)(void* user, RadCtx* c, int64_t block, int begin);
+} RadReplayObserver;
+
+/* Install `observer` (copied) and clear it with null. Not thread safe; set it between steps. */
+void rad_set_replay_observer(RadCtx* c, const RadReplayObserver* observer);
+
+/* Layer replay: the block the next step runs alone, or -1 (the default) for the whole model. An
+ * engine sets it to re-run one recorded block of the last step from the residual its caller
+ * restored; an architecture reads it at the top of step() and, when set, issues only that block.
+ * `rad_set_replay_block` refuses a block the architecture did not bracket. */
+int64_t rad_replay_block(const RadCtx* c);
+void    rad_set_replay_block(RadCtx* c, int64_t block);
+
+/* Defined by a runtime that carries the replay hook: a build tests this macro rather than the
+ * radiance version, because the hook may reach it as a downstream patch. */
+#define RAD_REPLAY_BLOCK 1
